# Public HomeNet compose environment template.
# Copy to a local .env and replace placeholders. Do not commit filled values.

HOMENET_DOMAIN=example.net
HOMENET_SERVER_IP=192.168.50.5
HOMENET_TIMEZONE=UTC
HOMENET_INSTANCE=instances/example-openwrt-pi
HOMENET_NETWORK_ROOT=/opt/homenet
HOMENET_OPS_IMAGE=homenet-ops:latest

HOMENET_OPS_PORT=9999

WG_HOST=vpn.example.net
WG_EASY_PASSWORD_HASH=REPLACE_WITH_WG_EASY_PASSWORD_HASH
WG_EASY_INSECURE=false
CLOUDFLARED_TOKEN=REPLACE_WITH_CLOUDFLARED_TUNNEL_TOKEN
CLOUDFLARED_LOGLEVEL=info
CF_DNS_API_TOKEN=REPLACE_WITH_CF_DNS_API_TOKEN
