set usteer.@usteer[0].network='lan'
set usteer.@usteer[0].syslog='1'
set usteer.@usteer[0].debug_level='1'
set usteer.@usteer[0].local_mode='0'
set usteer.@usteer[0].ipv6='0'
set usteer.@usteer[0].assoc_steering='0'
set usteer.@usteer[0].roam_scan_snr='-67'
set usteer.@usteer[0].roam_scan_tries='3'
set usteer.@usteer[0].roam_scan_timeout='60000'
set usteer.@usteer[0].roam_scan_interval='10000'
set usteer.@usteer[0].roam_trigger_snr='-72'
set usteer.@usteer[0].roam_trigger_interval='60000'
set usteer.@usteer[0].roam_kick_delay='30000'
set usteer.@usteer[0].steer_reject_timeout='60000'
set usteer.@usteer[0].signal_diff_threshold='12'
set usteer.@usteer[0].link_measurement_interval='30000'
set usteer.@usteer[0].load_kick_enabled='0'
set usteer.@usteer[0].band_steering_interval='0'
delete usteer.@usteer[0].ssid_list
add_list usteer.@usteer[0].ssid_list='HOME_SSID'
