CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax3000-ubootmod=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-proto-relay=y
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_zram-swap=y
# NSS stays disabled on the room AP candidate. Its weak wireless backhaul is
# a poor fit for the experimental NSS Wi-Fi data path.
# CONFIG_PACKAGE_nss-tools-dwmac is not set
# CONFIG_PACKAGE_MAC80211_NSS_SUPPORT is not set
# CONFIG_ATH11K_NSS_SUPPORT is not set
