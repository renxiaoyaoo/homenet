[Unit]
Description=Home OpenWrt presence receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/network
ExecStart=/usr/bin/python3 /home/pi/network/maintenance/presence/presence-receiver.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
