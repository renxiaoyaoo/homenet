[Unit]
Description=Mihomo Transparent Gateway Rules
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mihomo-gateway.sh start
ExecStop=/usr/local/bin/mihomo-gateway.sh stop

[Install]
WantedBy=multi-user.target
