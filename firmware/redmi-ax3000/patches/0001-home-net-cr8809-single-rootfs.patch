Subject: [PATCH] qualcommax: match the deployed CR8809 single-rootfs layout

The deployed CR8809 exposes a single rootfs partition from 0x00a80000 to
0x07f00000. Keep the final 1 MiB outside Linux, exactly as its validated
MIBIB/SMEM layout does.

Its modified bootloader already boots that single rootfs independently of
the Xiaomi slot flags. Do not rewrite bootloader environment variables during
sysupgrade; only replace the rootfs UBI partition.
---
 .../dts/ipq5018-redmi-ax3000-ubootmod.dts             | 2 +-
 .../qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh | 14 +-------------
 2 files changed, 2 insertions(+), 14 deletions(-)

diff --git a/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-ubootmod.dts b/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-ubootmod.dts
index 51e4814..0000000 100644
--- a/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-ubootmod.dts
+++ b/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-ubootmod.dts
@@ -140,7 +140,7 @@
 
 			partition@a80000 {
 				label = "rootfs";
-				reg = <0x00a80000 0x7580000>;
+				reg = <0x00a80000 0x7480000>;
 			};
 		};
 	};
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
index d6b0d8f..0000000 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
@@ -562,16 +562,7 @@ platform_do_upgrade() {
 		nand_do_upgrade "$1"
 		;;
 	xiaomi,redmi-ax3000-ubootmod)
-		# Enforce single partition layout by locking boot to slot 0
-		printf '%s\n' \
-			"flag_last_success 0" \
-			"flag_ota_reboot 0" \
-			"flag_try_sys1_failed 0" \
-			"flag_try_sys2_failed 0" \
-			"flag_boot_rootfs 0" \
-			"boot_wait on" \
-			"uart_en 1" > /tmp/xiaomi-env
-		fw_setenv -s /tmp/xiaomi-env
+		# The modified loader already boots the single rootfs partition.
 		CI_UBIPART="rootfs"
 		nand_do_upgrade "$1"
 		;;
-- 
2.47.3
